generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── ENUMS & STATE MANAGEMENT ─────────────────────────────────────────────────
enum Role {
  BRAND
  CREATOR
}

enum ContractStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_REVIEW
  APPROVED
  PAID
}

enum LeadStatus {
  DISCOVERED
  NEGOTIATING
  INVITED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ── CORE USER MODEL (Better Auth Compatible & Profile Relations) ─────────────
model User {
  id                     String   @id @default(cuid())
  email                  String   @unique
  emailVerified          Boolean  @default(false)
  name                   String?
  image                  String?
  role                   Role     @default(CREATOR)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  hasCompletedOnboarding Boolean  @default(false) @map("onboardingCompleted")

  // Better Auth & Messaging Relations
  accounts            Account[]
  sessions            Session[]
  platformTokens      PlatformToken[]
  platformStats       PlatformStats[]
  sentMessages        Message[]       @relation("SentMessages")
  receivedMessages    Message[]       @relation("ReceivedMessages")
  notifications       Notification[]
  sentConnections     Connection[]    @relation("SentConnections")
  receivedConnections Connection[]    @relation("ReceivedConnections")

  // Polymorphic Profile Relations (One-to-One)
  brandProfile   BrandProfile?
  creatorProfile CreatorProfile?
}

// ── BRAND PROFILE ECOSYSTEM ──────────────────────────────────────────────────
model BrandProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName      String
  industry         String?
  website          String?
  brandAccountType String? // "company" | "personal"
  bio              String?
  location         String?

  socialLinks Json? // [{ platform: string, url: string }]

  campaigns      Campaign[]
  crmLeads       CRMLead[]
  communityLists CommunityList[]
}

// ── CREATOR PROFILE (Media Kit & Cached Metrics) ─────────────────────────────
model CreatorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String?
  niche           String? // Target niche / content categories
  primaryPlatform String? // "youtube" | "tiktok" | "instagram"
  location        String?

  // Cached performance metrics for RapidAPI optimization
  totalFollowers    Int       @default(0)
  avgEngagementRate Float     @default(0)
  lastStatsUpdate   DateTime?
  socialLinks       Json? // [{ platform: string, url: string }]

  contracts Contract[]
  proposals Proposal[]
}

// ── BETTER AUTH REQUIRED INTERFACES (Immutable for Auth Compliance) ──────────
model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ── SOCIAL PLATFORMS & ACCESS TOKENS ─────────────────────────────────────────
model PlatformToken {
  id             String    @id @default(cuid())
  userId         String
  platform       String // "youtube" | "instagram" | "tiktok" | "facebook"
  accessToken    String
  refreshToken   String?
  expiresAt      DateTime?
  scopes         String?
  platformUserId String?
  username       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
}

model PlatformStats {
  id             String   @id @default(cuid())
  userId         String
  platform       String
  followerCount  Int?
  followingCount Int?
  postCount      Int?
  engagementRate Float?
  fetchedAt      DateTime @default(now())
  raw            Json?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
}

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  role      String // "brand" | "creator"
  createdAt DateTime @default(now())
}

// ── CORE MESSAGING SYSTEM ────────────────────────────────────────────────────
model Message {
  id         String   @id @default(cuid())
  text       String
  createdAt  DateTime @default(now())
  senderId   String
  receiverId String

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([senderId, receiverId])
}

// ── MARKETPLACE ENGINE & CRM MODULES (Sprint 1 Core) ─────────────────────────
model Campaign {
  id             String       @id @default(cuid())
  brandProfileId String
  brand          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  title          String
  description    String
  budget         Float
  status         String       @default("DRAFT") // DRAFT, ACTIVE, COMPLETED
  createdAt      DateTime     @default(now())

  proposals Proposal[]
  contracts Contract[]
}

model Proposal {
  id               String         @id @default(cuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  creatorProfileId String
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  coverLetter      String?
  rate             Float
  status           String         @default("PENDING") // PENDING, ACCEPTED, REJECTED
  createdAt        DateTime       @default(now())
}

model Contract {
  id               String         @id @default(cuid())
  campaignId       String
  campaign         Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  brandProfileId   String
  creatorProfileId String
  creator          CreatorProfile @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  status           ContractStatus @default(PENDING)
  totalBudget      Float
  createdAt        DateTime       @default(now())

  milestones Milestone[]
  tasks      Task[]
}

model Milestone {
  id         String          @id @default(cuid())
  contractId String
  contract   Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  percentage Float
  amount     Float
  status     MilestoneStatus @default(PENDING)
  dueDate    DateTime?
}

model CRMLead {
  id             String       @id @default(cuid())
  brandProfileId String
  brand          BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  handle         String
  platform       String // INSTAGRAM, TIKTOK
  avatarUrl      String?
  followers      Int          @default(0)
  status         LeadStatus   @default(DISCOVERED)
  notes          String?
  createdAt      DateTime     @default(now())
}

model Task {
  id         String    @id @default(cuid())
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  title      String
  dueDate    DateTime
  status     String    @default("TODO") // TODO, IN_PROGRESS, DONE
  createdAt  DateTime  @default(now())
}

// ── CONNECTIONS (LinkedIn-style request/accept) ───────────────────────────────
model Connection {
  id         String           @id @default(cuid())
  senderId   String
  sender     User             @relation("SentConnections", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User             @relation("ReceivedConnections", fields: [receiverId], references: [id], onDelete: Cascade)
  status     ConnectionStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([senderId, receiverId])
  @@index([senderId])
  @@index([receiverId])
}

// ── COMMUNITY LISTS (Brand-curated creator groups) ───────────────────────────
model CommunityList {
  id             String                @id @default(cuid())
  brandProfileId String
  brand          BrandProfile          @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  name           String
  createdAt      DateTime              @default(now())
  members        CommunityListMember[]

  @@index([brandProfileId])
}

model CommunityListMember {
  id            String        @id @default(cuid())
  listId        String
  list          CommunityList @relation(fields: [listId], references: [id], onDelete: Cascade)
  creatorUserId String
  addedAt       DateTime      @default(now())

  @@unique([listId, creatorUserId])
  @@index([listId])
}

// ── NOTIFICATION SYSTEM ───────────────────────────────────────────────────────
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "PROPOSAL_RECEIVED" | "PROPOSAL_ACCEPTED" | "PROPOSAL_REJECTED" | "MESSAGE"
  title     String
  body      String?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}
