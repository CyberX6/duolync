enable-pre-post-scripts=true

# The Prisma client is generated to lib/generated/prisma (outside node_modules),
# so its `require("@prisma/client-runtime-utils")` resolves from the project root
# rather than through @prisma/client's own dependency tree. pnpm's strict layout
# does not place that transitive package at the root, which breaks every server
# action at module load. Hoisting @prisma/* makes it resolvable.
public-hoist-pattern[]=@prisma/*
